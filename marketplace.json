    {
      "category": "database",
      "config_template": {
        "args": [
          "-y",
          "@bytebase/dbhub@1.5.0"
        ],
        "command": "npx"
      },
      "description": "Universal database gateway: Postgres, MySQL, MariaDB, SQL Server, SQLite and Oracle in one server, with read-only guards.",
      "featured": true,
      "id": "dbhub",
      "key_badge": "keyless",
      "license": "MIT",
      "name": "DBHub",
      "publisher": "Bytebase",
      "required_secrets": [],
      "risk_notes": [
        "With no --dsn it starts against a built-in --demo database; add --dsn <connection string> for a real database and prefer --readonly mode for agent use."
      ],
      "source_url": "https://github.com/bytebase/dbhub",
      "transport": "stdio",
      "verified": true,
      "version": "1.5.0"
    },
    {
      "category": "database",
      "config_template": {
        "args": [
          "-y",
          "@toolbox-sdk/server@1.15.0",
          "--prebuilt=postgres",
          "--stdio"
        ],
        "command": "npx"
      },
      "description": "Google's database toolbox: prebuilt and custom tools for enterprise databases (Postgres preset shown; many sources supported).",
      "featured": true,
      "id": "mcp-toolbox",
      "key_badge": "keyless",
      "license": "Apache-2.0",
      "name": "MCP Toolbox for Databases",
      "publisher": "Google",
      "required_secrets": [],
      "risk_notes": [
        "Template verified from the project README (googleapis/mcp-toolbox): the npx @toolbox-sdk/server wrapper is the documented MCP install path; a standalone `toolbox` binary is also published on the project's GitHub releases. Set the database connection env vars for the chosen --prebuilt source before use, and expect APIs to keep evolving between releases."
      ],
      "source_url": "https://github.com/googleapis/mcp-toolbox",
      "transport": "stdio",
      "verified": true,
      "version": "1.15.0"
    },
