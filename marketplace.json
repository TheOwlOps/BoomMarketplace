    {
      "category": "code",
      "config_template": {
        "transport": "http",
        "url": "https://api.githubcopilot.com/mcp/"
      },
      "description": "GitHub repos, issues and pull requests via GitHub's official hosted MCP server.",
      "featured": true,
      "id": "github",
      "key_badge": "free_key",
      "license": "MIT",
      "name": "GitHub MCP",
      "publisher": "GitHub",
      "required_secrets": [
        {
          "description": "GitHub personal access token (free) — value format: Bearer <token>",
          "in": "header",
          "name": "Authorization"
        }
      ],
      "risk_notes": [
        "Default toolset is ≈46 tools / ~11k tokens; do NOT enable all toolsets (91 tools / ~23k tokens) — keep the narrowed default."
      ],
      "source_url": "https://github.com/github/github-mcp-server",
      "tool_count_estimate": 46,
      "transport": "http",
      "verified": true,
      "version": ""
    },
    {
      "category": "files",
      "config_template": {
        "args": [
          "-y",
          "@modelcontextprotocol/server-filesystem@2.0.1"
        ],
        "command": "npx"
      },
      "description": "Reference filesystem server: read and write files inside explicitly allowed directories only.",
      "featured": true,
      "id": "filesystem",
      "key_badge": "keyless",
      "license": "MIT",
      "name": "Filesystem",
      "publisher": "Model Context Protocol",
      "required_secrets": [],
      "risk_notes": [
        "An allowed-directory argument is REQUIRED before use: append the directory path to the args in the review screen — the template ships no path on purpose, so nothing is exposed by default."
